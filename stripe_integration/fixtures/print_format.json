    "html": "<style>\n@page { size: A4; margin: 9mm 14mm 8mm; }\n@media print {\n  body { margin: 0; padding: 0; }\n  .invoice-section, .totals-table { page-break-inside: avoid; }\n  thead { display: table-header-group; }\n  tr { page-break-inside: avoid; }\n}\n.print-format, .invoice-document {\n  font-family: Arial, Helvetica, sans-serif;\n  color: #20252b;\n  font-size: 10px;\n  line-height: 1.45;\n}\n.invoice-document { width: 100%; }\n.invoice-document table { border-collapse: collapse; }\n.header-table { width: 100%; border-bottom: 2px solid #f15a24; margin-bottom: 10px; }\n.logo { width: 80px; max-width: 80px; height: auto; display: block; }\n.document-title { margin: 0; color: #20252b; font-size: 20px; font-weight: 700; line-height: 1; }\n.document-number { margin-top: 5px; color: #59636f; font-size: 10px; font-weight: 600; }\n.company-block { padding: 5px 0 7px; color: #59636f; font-size: 9px; line-height: 1.35; }\n.company-name { color: #20252b; font-size: 10px; font-weight: 700; }\n.company-tax { color: #cf4a1d; font-weight: 700; }\n.company-contact { text-align: right; }\n.invoice-section { width: 100%; margin-bottom: 10px; }\n.section-label { margin: 0 0 4px; color: #cf4a1d; font-size: 9px; font-weight: 700; text-transform: uppercase; }\n.customer-name { margin-bottom: 2px; color: #20252b; font-size: 13px; font-weight: 700; }\n.customer-detail { color: #59636f; font-size: 10px; line-height: 1.35; }\n.contact-email { margin-top: 3px; color: #59636f; }\n.details-table { width: 100%; border: 1px solid #dfe3e8; }\n.details-table td { padding: 4px 8px; border-bottom: 1px solid #e9edf0; }\n.details-table tr:last-child td { border-bottom: 0; }\n.detail-label { width: 48%; color: #6c7680; font-size: 9px; }\n.detail-value { color: #20252b; font-weight: 700; text-align: right; white-space: nowrap; }\n.status-paid { color: #18794e; }\n.status-open { color: #a65b00; }`n.status-partial { color: #a65b00; }\n.status-overdue { color: #c7351f; }\n.items-table { width: 100%; table-layout: fixed; margin-bottom: 10px; }\n.items-table th { padding: 6px 8px; background: #20252b; color: #ffffff; font-size: 9px; font-weight: 700; text-align: left; text-transform: uppercase; }\n.items-table th.qty { text-align: center; }\n.items-table th.money { text-align: right; }\n.items-table td { padding: 6px 8px; border-bottom: 1px solid #dfe3e8; color: #20252b; vertical-align: top; }\n.items-table td.qty { text-align: center; white-space: nowrap; }\n.items-table td.money { text-align: right; font-weight: 600; white-space: nowrap; }\n.item-name { font-size: 10px; font-weight: 700; }\n.item-description { padding: 0 8px 6px; color: #59636f; font-size: 9px; line-height: 1.35; }\n.item-description .ql-editor { padding: 0 !important; font-size: 9px !important; line-height: 1.35 !important; }\n.item-description .ql-editor p, .item-description .ql-editor span, .item-description .ql-editor li, .item-description p { margin: 0 !important; font-size: 9px !important; line-height: 1.35 !important; }\n.totals-wrap { width: 43%; min-width: 245px; margin-left: auto; margin-bottom: 12px; }\n.settlement-layout { width: 100%; margin-bottom: 12px; }\n.payment-history-title { margin: 0 0 5px; color: #cf4a1d; font-size: 9px; font-weight: 700; text-transform: uppercase; }\n.payment-history { width: 100%; border-top: 1px solid #cfd6dc; table-layout: fixed; }\n.payment-history th { padding: 4px 5px; color: #6c7680; font-size: 8px; font-weight: 700; text-align: left; text-transform: uppercase; }\n.payment-history th.money { text-align: right; }\n.payment-history td { padding: 5px; border-top: 1px solid #e9edf0; color: #20252b; font-size: 9px; vertical-align: top; }\n.payment-history td.money { text-align: right; font-weight: 700; white-space: nowrap; }\n.payment-history .reference-value { color: #59636f; overflow-wrap: break-word; }\n.settlement-layout .totals-wrap { width: 100%; min-width: 0; margin: 0; }\n.totals-table { width: 100%; border-top: 1px solid #cfd6dc; }\n.totals-table td { padding: 4px 0; color: #59636f; }\n.totals-table td:last-child { color: #20252b; font-weight: 600; text-align: right; white-space: nowrap; }\n.totals-table .discount td:last-child { color: #c7351f; }\n.totals-table .total-row td { padding-top: 7px; border-top: 2px solid #f15a24; color: #20252b; font-size: 13px; font-weight: 700; }\n.totals-table .total-row td:last-child { color: #cf4a1d; font-size: 15px; }\n.totals-table .balance-row td { padding-top: 5px; color: #a65b00; font-weight: 700; }\n.totals-table .balance-row td:last-child { color: #a65b00; }\n.terms-section { margin-top: 2px; padding-top: 7px; border-top: 1px solid #dfe3e8; }\n.terms-title { margin: 0 0 5px; color: #cf4a1d; font-size: 9px; font-weight: 700; text-transform: uppercase; }\n.terms-content { color: #59636f; font-size: 8.3px; line-height: 1.34; }\n.terms-content p { margin: 0 0 3px; }\n.invoice-footer { margin-top: 7px; color: #7a838c; font-size: 8px; }\n</style>\n\n{% set company = frappe.get_doc('Company', doc.company) %}\n{% set is_paid = doc.outstanding_amount == 0 %}\n{% set is_overdue = not is_paid and doc.status == 'Overdue' %}\n{% set is_partially_paid = not is_paid and doc.outstanding_amount > 0 and doc.outstanding_amount < doc.grand_total %}\n{% set payment_references = frappe.get_all('Payment Entry Reference', filters={'reference_doctype': 'Sales Invoice', 'reference_name': doc.name, 'parenttype': 'Payment Entry'}, fields=['parent', 'allocated_amount'], order_by='modified desc') %}\n\n<div class=\"invoice-document\">\n  <table class=\"header-table\" cellpadding=\"0\" cellspacing=\"0\">\n    <tr>\n      <td style=\"width: 50%; vertical-align: top; padding: 0 0 8px;\">\n        <img class=\"logo\" src=\"https://customer-assets.emergentagent.com/job_finance-templates-1/artifacts/mnesqu98_1234%20CO%20Logo%20.png\" alt=\"CoreOrbit\">\n      </td>\n      <td style=\"width: 50%; vertical-align: top; padding: 1px 0 8px; text-align: right;\">\n        <h1 class=\"document-title\">INVOICE</h1>\n        <div class=\"document-number\">{{ doc.name }}</div>\n      </td>\n    </tr>\n    <tr>\n      <td class=\"company-block\" style=\"width: 50%; vertical-align: top;\">\n        <div class=\"company-name\">CoreOrbit Systems Ltd.</div>\n        {% if company.tax_id %}<div class=\"company-tax\">Corporation No: {{ company.tax_id }}</div>{% endif %}\n        <div>6730 124 St<br>Surrey, BC V3W 0Z7<br>Canada</div>\n      </td>\n      <td class=\"company-block company-contact\" style=\"width: 50%; vertical-align: top;\">\n        <div>+1 778-776-7248</div>\n        <div>billing@coreorbit.io</div>\n        <div>coreorbit.io</div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"invoice-section\" cellpadding=\"0\" cellspacing=\"0\">\n    <tr>\n      <td style=\"width: 54%; vertical-align: top; padding-right: 24px;\">\n        <div class=\"section-label\">Bill to</div>\n        <div class=\"customer-name\">{{ doc.customer_name }}</div>\n        <div class=\"customer-detail\">\n          {% if doc.customer_address %}\n            {% set address = frappe.get_doc('Address', doc.customer_address) %}\n            {% if address.address_line1 %}{{ address.address_line1 }}<br>{% endif %}\n            {% if address.address_line2 %}{{ address.address_line2 }}<br>{% endif %}\n            {% if address.city or address.state or address.pincode %}{{ address.city }}{% if address.city and address.state %}, {% endif %}{{ address.state }} {{ address.pincode }}<br>{% endif %}\n            {% if address.country %}{{ address.country }}{% endif %}\n          {% endif %}\n        </div>\n        {% if doc.contact_email %}<div class=\"contact-email\">{{ doc.contact_email }}</div>{% endif %}\n        {% if doc.contact_mobile %}<div class=\"contact-email\">{{ doc.contact_mobile }}</div>{% endif %}\n      </td>\n      <td style=\"width: 46%; vertical-align: top;\">\n        <table class=\"details-table\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr><td class=\"detail-label\">Invoice date</td><td class=\"detail-value\">{{ doc.get_formatted('posting_date') }}</td></tr>\n          <tr><td class=\"detail-label\">Due date</td><td class=\"detail-value\">{{ doc.get_formatted('due_date') }}</td></tr>\n          <tr><td class=\"detail-label\">Terms</td><td class=\"detail-value\">{{ doc.payment_terms_template or 'Due on receipt' }}</td></tr>\n          <tr>\n            <td class=\"detail-label\">Payment status</td>\n            <td class=\"detail-value {% if is_paid %}status-paid{% elif is_overdue %}status-overdue{% elif is_partially_paid %}status-partial{% else %}status-open{% endif %}\">{% if is_paid %}Paid{% elif is_overdue %}Overdue{% elif is_partially_paid %}Partially paid{% else %}Payment due{% endif %}</td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"items-table\" cellpadding=\"0\" cellspacing=\"0\">\n    <colgroup>\n      <col style=\"width: 58%;\">\n      <col style=\"width: 12%;\">\n      <col style=\"width: 15%;\">\n      <col style=\"width: 15%;\">\n    </colgroup>\n    <thead>\n      <tr>\n        <th>Products and services</th>\n        <th class=\"qty\">Qty</th>\n        <th class=\"money\">Rate</th>\n        <th class=\"money\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr>\n        <td><div class=\"item-name\">{{ item.item_name }}</div></td>\n        <td class=\"qty\">{{ item.qty }}</td>\n        <td class=\"money\">{{ item.get_formatted('rate') }}</td>\n        <td class=\"money\">{{ item.get_formatted('amount') }}</td>\n      </tr>\n      {% if item.description %}\n      <tr>\n        <td colspan=\"4\" class=\"item-description\">{{ item.description }}</td>\n      </tr>\n      {% endif %}\n      {% endfor %}\n    </tbody>\n  </table>\n\n  {% if payment_references %}\n  <table class=\"settlement-layout\" cellpadding=\"0\" cellspacing=\"0\">\n    <tr>\n      <td style=\"width: 56%; vertical-align: top; padding-right: 24px;\">\n        <div class=\"payment-history-title\">Payments received</div>\n        <table class=\"payment-history\" cellpadding=\"0\" cellspacing=\"0\">\n          <colgroup>\n            <col style=\"width: 20%;\">\n            <col style=\"width: 27%;\">\n            <col style=\"width: 31%;\">\n            <col style=\"width: 22%;\">\n          </colgroup>\n          <thead>\n            <tr>\n              <th>Date</th>\n              <th>Method</th>\n              <th>Reference</th>\n              <th class=\"money\">Applied</th>\n            </tr>\n          </thead>\n          <tbody>\n            {% for payment_reference in payment_references %}\n              {% set payment = frappe.get_doc('Payment Entry', payment_reference.parent) %}\n              {% if payment.docstatus == 1 and payment.payment_type == 'Receive' %}\n              <tr>\n                <td>{{ payment.get_formatted('posting_date') }}</td>\n                <td>{% if payment.mode_of_payment %}{{ payment.mode_of_payment }}{% elif payment.paid_to and 'Stripe' in payment.paid_to %}Stripe{% else %}Online payment{% endif %}</td>\n                <td class=\"reference-value\">{{ payment.reference_no or '-' }}</td>\n                <td class=\"money\">{{ frappe.utils.fmt_money(payment_reference.allocated_amount, currency=doc.currency) }}</td>\n              </tr>\n              {% endif %}\n            {% endfor %}\n          </tbody>\n        </table>\n      </td>\n      <td style=\"width: 44%; vertical-align: top;\">\n        <div class=\"totals-wrap\">\n          <table class=\"totals-table\" cellpadding=\"0\" cellspacing=\"0\">\n            {% if doc.discount_amount %}\n            <tr class=\"discount\"><td>Discount</td><td>-{{ doc.get_formatted('discount_amount') }}</td></tr>\n            {% endif %}\n            <tr><td>Subtotal</td><td>{{ doc.get_formatted('net_total') }}</td></tr>\n            {% for tax in doc.taxes %}\n            <tr><td>{{ tax.description }}</td><td>{{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}</td></tr>\n            {% endfor %}\n            {% if doc.rounding_adjustment %}\n            <tr><td>Rounding adjustment</td><td>{{ doc.get_formatted('rounding_adjustment') }}</td></tr>\n            {% endif %}\n            <tr class=\"total-row\"><td>Total</td><td>{{ doc.get_formatted('grand_total') }}</td></tr>\n            {% if not is_paid %}\n            <tr class=\"balance-row\"><td>Balance due</td><td>{{ doc.get_formatted('outstanding_amount') }}</td></tr>\n            {% endif %}\n          </table>\n        </div>\n      </td>\n    </tr>\n  </table>\n  {% else %}\n  <div class=\"totals-wrap\">\n    <table class=\"totals-table\" cellpadding=\"0\" cellspacing=\"0\">\n      {% if doc.discount_amount %}\n      <tr class=\"discount\"><td>Discount</td><td>-{{ doc.get_formatted('discount_amount') }}</td></tr>\n      {% endif %}\n      <tr><td>Subtotal</td><td>{{ doc.get_formatted('net_total') }}</td></tr>\n      {% for tax in doc.taxes %}\n      <tr><td>{{ tax.description }}</td><td>{{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}</td></tr>\n      {% endfor %}\n      {% if doc.rounding_adjustment %}\n      <tr><td>Rounding adjustment</td><td>{{ doc.get_formatted('rounding_adjustment') }}</td></tr>\n      {% endif %}\n      <tr class=\"total-row\"><td>Total</td><td>{{ doc.get_formatted('grand_total') }}</td></tr>\n      {% if not is_paid %}\n      <tr class=\"balance-row\"><td>Balance due</td><td>{{ doc.get_formatted('outstanding_amount') }}</td></tr>\n      {% endif %}\n    </table>\n  </div>\n  {% endif %}\n\n  {% if doc.terms %}\n  <div class=\"terms-section\">\n    <div class=\"terms-title\">Terms and conditions</div>\n    <div class=\"terms-content\">{{ doc.terms }}</div>\n  </div>\n  {% endif %}\n\n  <div class=\"invoice-footer\">CoreOrbit Systems Ltd. | 6730 124 St, Surrey, BC V3W 0Z7, Canada</div>\n</div>",
