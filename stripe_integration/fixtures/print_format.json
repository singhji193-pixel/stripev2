    "html": "<style>\n@page { size: A4; margin: 0; }\n@media print {\n  body { margin: 0; padding: 0; }\n  .no-break { page-break-inside: avoid; }\n  .keep-together { page-break-inside: avoid; page-break-after: avoid; }\n  table { page-break-inside: auto; }\n  tr { page-break-inside: avoid; page-break-after: auto; }\n}\n</style>\n<div style=\"font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; padding: 20px 20px; background: #ffffff; color: #1f2937;\">\n    \n    <!-- Header with Logo and Invoice Title - OPTIMIZED -->\n    <table style=\"width: 100%; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 3px solid #130033;\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n            <td style=\"width: 50%; vertical-align: top; padding-bottom: 10px;\">\n                <img src=\"https://storagev2.files-vault.com/uploads/blacklabel-201/sub-account-61337/thinnercoengine.webp\" alt=\"COEngine\" style=\"width: 150px; max-width: 150px; height: auto; display: block; margin-bottom: 8px;\">\n            </td>\n            <td style=\"width: 50%; text-align: right; vertical-align: top; padding-bottom: 10px;\">\n                <h1 style=\"margin: 0 0 4px 0; font-size: 30px; font-weight: 700; color: #1f2937; letter-spacing: -0.5px;\">INVOICE</h1>\n                <div style=\"font-size: 12px; color: #6b7280;\">\n                    <strong style=\"color: #1f2937;\">{{ doc.name }}</strong>\n                </div>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"width: 50%; vertical-align: top; font-size: 10px; line-height: 1.5; color: #6b7280; padding-top: 10px;\">\n                <strong style=\"color: #1f2937; font-size: 11px;\">COEngine Service Inc.</strong><br>\n                {% if frappe.get_doc('Company', doc.company).tax_id %}\n                <span style=\"color: #130033; font-weight: 600; font-size: 10px;\">\n                    Corporation No: {{ frappe.get_doc('Company', doc.company).tax_id }}\n                </span><br>\n                {% endif %}\n                6730 124 St<br>\n                Surrey, BC V3W 0Z7<br>\n                Canada\n            </td>\n            <td style=\"width: 50%; text-align: right; vertical-align: top; font-size: 10px; line-height: 1.5; color: #6b7280; padding-top: 10px;\">\n                (778)-786-7248<br>\n                billing@coengine.ai<br>\n                https://coengine.ai/\n            </td>\n        </tr>\n    </table>\n\n    <!-- Invoice Details & Customer Info - OPTIMIZED -->\n    <table style=\"width: 100%; margin-bottom: 15px;\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n            <td style=\"width: 40%; vertical-align: top; padding-right: 15px;\">\n                <h3 style=\"margin: 0 0 8px 0; font-size: 10px; font-weight: 600; color: #130033; text-transform: uppercase; letter-spacing: 1px;\">Bill To</h3>\n                <div style=\"font-size: 12px; line-height: 1.5; color: #1f2937;\">\n                    <strong style=\"font-size: 14px; display: block; margin-bottom: 5px; color: #1f2937;\">{{ doc.customer_name }}</strong>\n                    \n                    {% if doc.customer_address %}\n                        {% set address = frappe.get_doc(\"Address\", doc.customer_address) %}\n                        <div style=\"color: #4b5563; font-size: 11px; line-height: 1.6;\">\n                            {% if address.address_line1 %}\n                                {{ address.address_line1 }}<br>\n                            {% endif %}\n                            {% if address.address_line2 %}\n                                {{ address.address_line2 }}<br>\n                            {% endif %}\n                            {% if address.city or address.state or address.pincode %}\n                                {{ address.city }}{% if address.city and address.state %}, {% endif %}{{ address.state }} {{ address.pincode }}<br>\n                            {% endif %}\n                            {% if address.country %}\n                                {{ address.country }}\n                            {% endif %}\n                        </div>\n                    {% endif %}\n                    \n                    {% if doc.contact_email %}\n                        <div style=\"margin-top: 6px; color: #6b7280; font-size: 11px;\">\n                            <span style=\"display: inline-block; padding: 2px 6px; background: #f3f4f6; border-radius: 3px;\">\n                                {{ doc.contact_email }}\n                            </span>\n                        </div>\n                    {% endif %}\n                    \n                    {% if doc.contact_mobile %}\n                        <div style=\"margin-top: 4px; color: #6b7280; font-size: 11px;\">\n                            {{ doc.contact_mobile }}\n                        </div>\n                    {% endif %}\n                </div>\n            </td>\n            <td style=\"width: 60%; vertical-align: top;\">\n                <div style=\"background: #f9fafb; padding: 12px; border-radius: 6px; border-left: 3px solid #130033;\">\n                    <table style=\"width: 100%; font-size: 11px; line-height: 1.6;\" cellpadding=\"0\" cellspacing=\"0\">\n                        <tr>\n                            <td style=\"color: #6b7280; font-weight: 500; padding: 2px 0;\">Invoice #:</td>\n                            <td style=\"text-align: right; color: #1f2937; font-weight: 600; padding: 2px 0;\">{{ doc.name }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"color: #6b7280; font-weight: 500; padding: 2px 0;\">Terms:</td>\n                            <td style=\"text-align: right; color: #1f2937; font-weight: 600; padding: 2px 0;\">{{ doc.payment_terms_template or \"Net 30\" }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"color: #6b7280; font-weight: 500; padding: 2px 0;\">Invoice Date:</td>\n                            <td style=\"text-align: right; color: #1f2937; font-weight: 600; padding: 2px 0;\">{{ doc.get_formatted(\"posting_date\") }}</td>\n                        </tr>\n                        <tr>\n                            <td style=\"color: #6b7280; font-weight: 500; padding: 2px 0;\">Due Date:</td>\n                            <td style=\"text-align: right; color: #1f2937; font-weight: 600; padding: 2px 0;\">{{ doc.get_formatted(\"due_date\") }}</td>\n                        </tr>\n                    </table>\n                </div>\n            </td>\n        </tr>\n    </table>\n\n    <!-- Items Table - OPTIMIZED -->\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 11px;\" cellpadding=\"0\" cellspacing=\"0\">\n        <thead>\n            <tr style=\"background: #1f2937; color: white;\">\n                <th style=\"padding: 8px 10px; text-align: left; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 9px;\">Product/Services</th>\n                <th style=\"padding: 8px 10px; text-align: center; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 9px;\">Qty/Hrs</th>\n                <th style=\"padding: 8px 10px; text-align: right; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 9px;\">Rate</th>\n                <th style=\"padding: 8px 10px; text-align: right; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 9px;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr style=\"border-bottom: 1px solid #e5e7eb;\">\n                <td style=\"padding: 7px 10px; color: #1f2937;\">\n                    <strong style=\"display: block; margin-bottom: 2px; font-size: 12px;\">{{ item.item_name }}</strong>\n                    {% if item.description %}\n                        <span style=\"color: #6b7280; font-size: 10px; display: block; line-height: 1.3; max-height: 26px; overflow: hidden;\">{{ item.description }}</span>\n                    {% endif %}\n                </td>\n                <td style=\"padding: 7px 10px; text-align: center; color: #1f2937;\">{{ item.qty }}</td>\n                <td style=\"padding: 7px 10px; text-align: right; color: #1f2937;\">{{ item.get_formatted(\"rate\") }}</td>\n                <td style=\"padding: 7px 10px; text-align: right; color: #1f2937; font-weight: 600;\">{{ item.get_formatted(\"amount\") }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <!-- Totals Section - OPTIMIZED -->\n    <div style=\"background: #f9fafb; padding: 12px; border-radius: 6px; border: 2px solid #130033; margin-bottom: 15px;\">\n        <table style=\"width: 100%; font-size: 12px;\" cellpadding=\"0\" cellspacing=\"0\">\n            <tr>\n                <td style=\"padding: 4px 0; color: #6b7280; font-weight: 500;\">Subtotal:</td>\n                <td style=\"padding: 4px 0; text-align: right; color: #1f2937; font-weight: 600;\">{{ doc.get_formatted(\"total\") }}</td>\n            </tr>\n            {% if doc.taxes %}\n                {% for tax in doc.taxes %}\n                <tr>\n                    <td style=\"padding: 4px 0; color: #6b7280; font-weight: 500;\">{{ tax.description }}:</td>\n                    <td style=\"padding: 4px 0; text-align: right; color: #1f2937; font-weight: 600;\">{{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}</td>\n                </tr>\n                {% endfor %}\n            {% endif %}\n            {% if doc.discount_amount %}\n            <tr>\n                <td style=\"padding: 4px 0; color: #6b7280; font-weight: 500;\">Discount:</td>\n                <td style=\"padding: 4px 0; text-align: right; color: #130033; font-weight: 600;\">-{{ doc.get_formatted(\"discount_amount\") }}</td>\n            </tr>\n            {% endif %}\n            <tr style=\"border-top: 2px solid #130033;\">\n                <td style=\"padding: 10px 0 0 0; color: #1f2937; font-weight: 700; font-size: 14px;\">Total:</td>\n                <td style=\"padding: 10px 0 0 0; text-align: right; color: #130033; font-weight: 700; font-size: 16px;\">{{ doc.get_formatted(\"grand_total\") }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Payment Status Banner - NEW -->\n    {% if doc.status == \"Paid\" or (doc.outstanding_amount is defined and doc.outstanding_amount == 0) %}\n        <div style=\"background: #10b981; color: white; padding: 12px 15px; border-radius: 6px; text-align: center; margin-bottom: 15px; font-weight: 700; font-size: 14px; letter-spacing: 0.5px;\">\n            \u2713 PAID\n        </div>\n    {% elif doc.status == \"Unpaid\" or (doc.outstanding_amount is defined and doc.outstanding_amount == doc.grand_total) %}\n        <div style=\"background: #ef4444; color: white; padding: 12px 15px; border-radius: 6px; text-align: center; margin-bottom: 15px; font-weight: 700; font-size: 14px; letter-spacing: 0.5px;\">\n            \u26a0 UNPAID\n        </div>\n    {% elif doc.status == \"Partly Paid\" or (doc.outstanding_amount is defined and doc.outstanding_amount > 0 and doc.outstanding_amount < doc.grand_total) %}\n        <div style=\"background: #f59e0b; color: white; padding: 12px 15px; border-radius: 6px; text-align: center; margin-bottom: 15px; font-weight: 700; font-size: 14px; letter-spacing: 0.5px;\">\n            \u26a0 PARTIALLY PAID - Outstanding: {{ doc.get_formatted(\"outstanding_amount\") }}\n        </div>\n    {% endif %}\n\n    <!-- Terms & Conditions - OPTIMIZED -->\n    {% if doc.terms %}\n    <div style=\"margin-top: 12px; padding: 10px; background: #f9fafb; border-left: 3px solid #130033; border-radius: 4px;\">\n        <h3 style=\"margin: 0 0 6px 0; font-size: 10px; font-weight: 600; color: #130033; text-transform: uppercase; letter-spacing: 1px;\">Terms & Conditions</h3>\n        <div style=\"font-size: 10px; line-height: 1.5; color: #4b5563;\">{{ doc.terms }}</div>\n    </div>\n    {% endif %}\n\n</div>\n",
